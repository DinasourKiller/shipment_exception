# ==============================================================================
# Environment Configuration Template
# Shipment Exception Control Tower
# Copy this file to .env and adjust values for your local environment.
# DO NOT commit .env containing actual secrets to version control.
# ==============================================================================

# Application Configuration
ENVIRONMENT=development
APP_NAME="Shipment Exception Control Tower"
APP_VERSION=1.0.0
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & CORS
# JSON list of allowed origins or comma-separated strings
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=replace-with-a-64-character-random-secret-key-for-development-use-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# Cookie Security (for refresh token)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shipment_control_tower
POSTGRES_SCHEMA=public
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# External Integrations - Mendix
MENDIX_BASE_URL=https://mendix-test.enterprise.local/rest
MENDIX_API_KEY=mendix-test-api-key
MENDIX_TIMEOUT_SECONDS=10
MENDIX_MAX_RETRIES=3

# AI Runtime - Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
