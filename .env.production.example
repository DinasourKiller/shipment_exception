# ==============================================================================
# Enterprise Shipment Exception Control Tower - Production Configuration Template
# ==============================================================================

# Application Metadata
APP_NAME="Shipment Exception Control Tower"
APP_VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False

# API Routing & CORS
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["https://controltower.corp", "https://app.controltower.corp"]
CORS_ALLOW_CREDENTIALS=True

# Database Configuration (PostgreSQL 16/18)
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_PRODUCTION_PASSWORD"
POSTGRES_DB="shipment_control_tower"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Security & Cryptography (RS256 JWT)
# In production, provide file paths to RSA 2048/4096-bit PEM keys or inline strings
JWT_ALGORITHM="RS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PRIVATE_KEY_PATH="/etc/ssl/controltower/jwt_private.pem"
JWT_PUBLIC_KEY_PATH="/etc/ssl/controltower/jwt_public.pem"

# Mendix Logistics Platform Integration
MENDIX_BASE_URL="https://mendix-logistics.internal.corp"
MENDIX_API_KEY="REPLACE_WITH_PRODUCTION_MENDIX_API_KEY"
MENDIX_TIMEOUT_SECONDS=10.0
MENDIX_MAX_RETRIES=3

# Local Ollama AI Engine
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="gemma2:2b"
OLLAMA_TIMEOUT_SECONDS=30.0

# Worker Process Scaling
WORKERS=4
